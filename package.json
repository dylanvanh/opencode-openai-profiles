{
	"name": "opencode-openai-profiles",
	"version": "0.1.5",
	"description": "OpenCode TUI plugin for switching saved OpenAI ChatGPT OAuth profiles.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dylanvanh/opencode-openai-profiles.git"
	},
	"bugs": {
		"url": "https://github.com/dylanvanh/opencode-openai-profiles/issues"
	},
	"homepage": "https://github.com/dylanvanh/opencode-openai-profiles#readme",
	"type": "module",
	"main": "dist/server.js",
	"types": "dist/server.d.ts",
	"exports": {
		".": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./tui": {
			"types": "./dist/tui.d.ts",
			"import": "./dist/tui.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
	},
	"keywords": [
		"opencode",
		"plugin",
		"openai",
		"chatgpt"
	],
	"peerDependencies": {
		"@opencode-ai/plugin": ">=1.14.33"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@opencode-ai/plugin": "^1.15.0",
		"@types/node": "^24.10.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.15"
	},
	"dependencies": {
		"@opencode-ai/sdk": "^1.15.0"
	}
}
